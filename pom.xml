<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>souris</groupId>
	<artifactId>botdealer</artifactId>
	<version>0.1.0</version>
	<name>BotDealer</name>
	<description>BotDealer - Discord gambling (chorizos), music and TTS bot with a JavaFX desktop app</description>
	<url>https://github.com/SourisCG/BotDealer</url>
	<licenses>
		<license>
			<name>GNU General Public License, version 3</name>
			<url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<javafx.version>25.0.4</javafx.version>
		<jda.version>6.7.0</jda.version>
		<jdave.version>0.1.8</jdave.version>
		<udpqueue.version>0.2.12</udpqueue.version>
		<opus-java.version>1.1.1</opus-java.version>
		<lavaplayer.version>2.2.7</lavaplayer.version>
		<youtube-source.version>1.18.2</youtube-source.version>
		<piper-jni.version>1.4.1</piper-jni.version>
		<java-keyring.version>1.0.4</java-keyring.version>
		<lombok.version>1.18.48</lombok.version>

		<!-- jpackage metadata. CI overrides app.version from the release tag. -->
		<app.version>${project.version}</app.version>
		<app.vendor>Sebastián García</app.vendor>
		<app.description>BotDealer - Discord gambling (chorizos), music and TTS bot with a JavaFX desktop app</app.description>
		<jpackage.dest>${project.build.directory}/dist</jpackage.dest>
		<jpackage.input>${project.build.directory}/app</jpackage.input>
		<!--
			JDK used to build the runtime image. Defaults to the JDK running Maven; override
			with -Djpackage.home=/path/to/jdk when the local JDK cannot run jlink (some Linux
			distributions ship a modified java.security and jlink refuses to use it).
		-->
		<jpackage.home>${java.home}</jpackage.home>
		<!--
			Modules bundled into the jlink runtime. java.se covers the whole Java SE API
			(Hibernate needs java.sql/java.naming, JDA needs java.net.http, JavaFX needs
			java.desktop/java.xml). The jdk.* extras are what the full JDK provides but
			java.se does not:
			  jdk.security.auth  -> com.sun.security.auth.module.UnixSystem, used by
			                        java-keyring's freedesktop backend (without it the
			                        packaged app silently loses the OS keychain)
			  jdk.crypto.ec      -> TLS elliptic curves for Discord HTTPS
			  jdk.zipfs          -> zip filesystem
			  jdk.charsets       -> non-UTF-8 charsets
			  jdk.localedata     -> non-English locales
			  jdk.net            -> unix domain sockets (D-Bus transports)
			JavaFX itself rides on the classpath: as of JavaFX 25 that works as long as the
			main class is not an Application subclass.
		-->
		<jpackage.modules>java.se,jdk.security.auth,jdk.crypto.ec,jdk.zipfs,jdk.charsets,jdk.localedata,jdk.net,jdk.unsupported,jdk.unsupported.desktop,jdk.jfr</jpackage.modules>
		<jpackage.jvm.options>--enable-native-access=ALL-UNNAMED</jpackage.jvm.options>
	</properties>

	<!-- jpackage executable name differs on Windows -->
	<profiles>
		<profile>
			<id>os-unix</id>
			<activation>
				<os><family>unix</family></os>
			</activation>
			<properties>
				<jpackage.bin>${jpackage.home}/bin/jpackage</jpackage.bin>
			</properties>
		</profile>
		<profile>
			<id>os-windows</id>
			<activation>
				<os><family>windows</family></os>
			</activation>
			<properties>
				<jpackage.bin>${jpackage.home}/bin/jpackage.exe</jpackage.bin>
			</properties>
		</profile>

		<!--
			Native packaging: builds a self-contained application image plus an installer.
			The image bundles its own Java runtime, so end users install nothing.

			  mvn -Ppackage -Djpackage.type=app-image package     portable folder
			  mvn -Ppackage -Djpackage.type=rpm       package     Fedora/RHEL
			  mvn -Ppackage -Djpackage.type=deb       package     Debian/Mint/Ubuntu
			  mvn -Ppackage -Djpackage.type=exe       package     Windows installer
		-->
		<profile>
			<id>package</id>
			<properties>
				<jpackage.type>app-image</jpackage.type>
				<!-- -Dskip.assets=true builds a small installer without the bundled voices/engines. -->
				<skip.assets>false</skip.assets>
			</properties>
			<build>
				<plugins>
					<!-- The jpackage input must be a plain classpath jar, not the Spring Boot fat jar. -->
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<configuration>
							<outputDirectory>${jpackage.input}</outputDirectory>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-runtime-dependencies</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>copy-dependencies</goal>
								</goals>
								<configuration>
									<outputDirectory>${jpackage.input}</outputDirectory>
									<includeScope>runtime</includeScope>
									<excludeGroupIds>org.projectlombok</excludeGroupIds>
									<overWriteReleases>false</overWriteReleases>
									<overWriteSnapshots>true</overWriteSnapshots>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-clean-plugin</artifactId>
						<executions>
							<execution>
								<id>clean-jpackage-destination</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>clean</goal>
								</goals>
								<configuration>
									<excludeDefaultDirectories>true</excludeDefaultDirectories>
									<filesets>
										<fileset>
											<directory>${jpackage.dest}</directory>
										</fileset>
									</filesets>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!--
						Downloads the bundled Piper voices and the yt-dlp/Deno binaries into the
						jpackage input, so the installers are self-contained. Skippable with
						-Dskip.assets=true; already-present files are left alone, which makes a CI
						cache hit free.
					-->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>download-bundled-assets</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>java</goal>
								</goals>
								<configuration>
									<skip>${skip.assets}</skip>
									<mainClass>souris.botdealer.diagnostics.AssetFetcher</mainClass>
									<arguments>
										<argument>${jpackage.input}</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>jpackage</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${jpackage.bin}</executable>
									<arguments>
										<argument>--type</argument>
										<argument>${jpackage.type}</argument>
										<argument>--name</argument>
										<argument>BotDealer</argument>
										<argument>--app-version</argument>
										<argument>${app.version}</argument>
										<argument>--vendor</argument>
										<argument>${app.vendor}</argument>
										<argument>--description</argument>
										<argument>${app.description}</argument>
										<argument>--input</argument>
										<argument>${jpackage.input}</argument>
										<argument>--main-jar</argument>
										<argument>${project.build.finalName}.jar</argument>
										<argument>--main-class</argument>
										<argument>souris.botdealer.BotDealerApplication</argument>
										<argument>--add-modules</argument>
										<argument>${jpackage.modules}</argument>
										<argument>--java-options</argument>
										<argument>${jpackage.jvm.options}</argument>
										<argument>--dest</argument>
										<argument>${jpackage.dest}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<!--
		Repositories for artifacts that are not on Maven Central.
		Central is declared FIRST on purpose: Maven queries repositories in order, and
		JitPack answers for any GitHub-style group id (io.github.*) with its own build.
		Without this ordering, JitPack shadowed the real io.github.jvoice-project:piper-jni
		jar with a 15 KB stub containing no native libraries, silently breaking offline TTS.
		JitPack is only needed for LavaPlayer's optional JAADec/IBXM decoders.
	-->
	<repositories>
		<repository>
			<id>central</id>
			<name>Maven Central</name>
			<url>https://repo1.maven.org/maven2</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
		<repository>
			<id>lavalink</id>
			<name>Lavalink Maven</name>
			<url>https://maven.lavalink.dev/releases</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
		<repository>
			<id>jitpack</id>
			<name>JitPack (LavaPlayer optional audio decoders)</name>
			<url>https://jitpack.io</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- Spring: persistence only. No web server (desktop app), no actuator, no H2 console (token exposure). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- Discord -->
		<dependency>
			<groupId>net.dv8tion</groupId>
			<artifactId>JDA</artifactId>
			<version>${jda.version}</version>
		</dependency>
		<!-- DAVE E2E encryption for Discord voice (mandatory since 2026-03-01). Requires Java 25. -->
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>jdave-api</artifactId>
			<version>${jdave.version}</version>
		</dependency>
		<!-- libdave natives for every target platform; the loader picks the right one at runtime. -->
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>jdave-native-linux-x86-64</artifactId>
			<version>${jdave.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>jdave-native-linux-aarch64</artifactId>
			<version>${jdave.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>jdave-native-win-x86-64</artifactId>
			<version>${jdave.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>jdave-native-darwin</artifactId>
			<version>${jdave.version}</version>
		</dependency>
		<!-- Native UDP send loop (optional performance; falls back to DefaultSendFactory). -->
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>udpqueue-native-linux-x86-64</artifactId>
			<version>${udpqueue.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>udpqueue-native-linux-aarch64</artifactId>
			<version>${udpqueue.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>udpqueue-native-win-x86-64</artifactId>
			<version>${udpqueue.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>udpqueue-native-darwin</artifactId>
			<version>${udpqueue.version}</version>
		</dependency>
		<!-- Opus encode/decode (volume control, TTS pipeline). Single jar with all platforms. -->
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>opus-java</artifactId>
			<version>${opus-java.version}</version>
		</dependency>
		<dependency>
			<groupId>club.minnced</groupId>
			<artifactId>opus-java-natives</artifactId>
			<version>${opus-java.version}</version>
		</dependency>

		<!-- Music playback -->
		<dependency>
			<groupId>dev.arbjerg</groupId>
			<artifactId>lavaplayer</artifactId>
			<version>${lavaplayer.version}</version>
		</dependency>
		<dependency>
			<groupId>dev.lavalink.youtube</groupId>
			<artifactId>v2</artifactId>
			<version>${youtube-source.version}</version>
		</dependency>

		<!-- Offline neural TTS (Piper). Jar bundles natives for win/linux/mac x64+arm64. GPL-3.0. -->
		<dependency>
			<groupId>io.github.jvoice-project</groupId>
			<artifactId>piper-jni</artifactId>
			<version>${piper-jni.version}</version>
		</dependency>

		<!-- OS keychain for secrets (Windows Credential Manager / macOS Keychain / Linux Secret Service). -->
		<dependency>
			<groupId>com.github.javakeyring</groupId>
			<artifactId>java-keyring</artifactId>
			<version>${java-keyring.version}</version>
		</dependency>

		<!-- JavaFX (platform classifier resolved at build time by the openjfx POM profiles). -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.9.0</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[25,26)</version>
								</requireJavaVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>25</release>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>souris.botdealer.BotDealerApplication</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>souris.botdealer.BotDealerApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- jpackage ("package") and distributable ("portable") profiles are added in Phase 2. -->
</project>
