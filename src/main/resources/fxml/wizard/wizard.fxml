<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- First-run setup wizard. Steps are panes inside one StackPane; the controller
     toggles visibility so the footer (Back/Next) and state stay shared. -->
<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.botdealer.ui.wizard.WizardController"
    styleClass="wizard-root"
    spacing="16">
    <padding>
        <Insets top="28" right="36" bottom="24" left="36"/>
    </padding>

    <Label fx:id="stepIndicatorLabel" styleClass="step-indicator"/>
    <Label fx:id="titleLabel" styleClass="wizard-title" wrapText="true"/>
    <Label fx:id="subtitleLabel" styleClass="wizard-subtitle" wrapText="true"/>

    <StackPane fx:id="stepContainer" VBox.vgrow="ALWAYS">
        <!-- Step 1: language -->
        <VBox fx:id="stepLanguage" styleClass="step-pane" spacing="14">
            <Label text="%wizard.language.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="10">
                <RadioButton fx:id="languageEnButton" text="%wizard.language.en" styleClass="option-radio"/>
                <RadioButton fx:id="languageEsButton" text="%wizard.language.es" styleClass="option-radio"/>
            </VBox>
            <Label text="%wizard.language.hint" styleClass="note-label" wrapText="true"/>
        </VBox>

        <!-- Step 2: Discord token -->
        <VBox fx:id="stepToken" styleClass="step-pane" spacing="12">
            <Label text="%wizard.token.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="10">
                <Label text="%wizard.token.label" styleClass="field-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <PasswordField fx:id="tokenField" promptText="%wizard.token.prompt" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="testTokenButton" text="%wizard.token.test" onAction="#testToken"
                        styleClass="secondary-button"/>
                    <ProgressIndicator fx:id="tokenProgress" prefWidth="20" prefHeight="20" visible="false"/>
                </HBox>
                <Label fx:id="tokenResultLabel" styleClass="result-label" wrapText="true"/>
                <Label fx:id="tokenIdentityLabel" styleClass="result-ok" wrapText="true"/>
            </VBox>
            <Label text="%wizard.token.storeNote" styleClass="note-label" wrapText="true"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Hyperlink text="%wizard.token.help" onAction="#openTokenHelp"/>
                <Hyperlink text="%wizard.token.skipHint" onAction="#skipToken"/>
            </HBox>
        </VBox>

        <!-- Step 3: economy -->
        <VBox fx:id="stepEconomy" styleClass="step-pane" spacing="12">
            <Label text="%wizard.economy.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="12">
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.economy.singular" styleClass="field-label"/>
                        <TextField fx:id="currencySingularField"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.economy.plural" styleClass="field-label"/>
                        <TextField fx:id="currencyPluralField"/>
                    </VBox>
                    <VBox spacing="6" prefWidth="90">
                        <Label text="%wizard.economy.symbol" styleClass="field-label"/>
                        <TextField fx:id="currencySymbolField"/>
                    </VBox>
                </HBox>
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.economy.startingBalance" styleClass="field-label"/>
                        <Spinner fx:id="startingBalanceSpinner" editable="true">
                        </Spinner>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.economy.dailyAmount" styleClass="field-label"/>
                        <Spinner fx:id="dailyAmountSpinner" editable="true">
                        </Spinner>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.economy.dailyCooldown" styleClass="field-label"/>
                        <Spinner fx:id="dailyCooldownSpinner" editable="true">
                        </Spinner>
                    </VBox>
                </HBox>
            </VBox>
            <Label text="%wizard.economy.hint" styleClass="note-label" wrapText="true"/>
        </VBox>

        <!-- Step 4: music engine -->
        <VBox fx:id="stepMusic" styleClass="step-pane" spacing="12">
            <Label text="%wizard.music.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="12">
                <VBox spacing="2">
                    <RadioButton fx:id="engineAutoButton" text="%wizard.music.engine.auto.title"
                        styleClass="option-radio"/>
                    <Label text="%wizard.music.engine.auto.body" styleClass="option-detail" wrapText="true"/>
                </VBox>
                <VBox spacing="2">
                    <RadioButton fx:id="engineDirectButton" text="%wizard.music.engine.direct.title"
                        styleClass="option-radio"/>
                    <Label text="%wizard.music.engine.direct.body" styleClass="option-detail" wrapText="true"/>
                </VBox>
                <VBox spacing="2">
                    <RadioButton fx:id="engineYtdlpButton" text="%wizard.music.engine.ytdlp.title"
                        styleClass="option-radio"/>
                    <Label text="%wizard.music.engine.ytdlp.body" styleClass="option-detail" wrapText="true"/>
                </VBox>
            </VBox>
            <Label text="%wizard.music.adsNote" styleClass="note-label" wrapText="true"/>
            <Label text="%wizard.music.oauthNote" styleClass="note-label" wrapText="true"/>
        </VBox>

        <!-- Step 5: TTS -->
        <VBox fx:id="stepTts" styleClass="step-pane" spacing="12">
            <Label text="%wizard.tts.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="12">
                <CheckBox fx:id="ttsEnabledCheck" text="%wizard.tts.enabled"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="%wizard.tts.voice" styleClass="field-label"/>
                        <ComboBox fx:id="ttsVoiceCombo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label fx:id="ttsSpeedLabel" styleClass="field-label"/>
                    <Slider fx:id="ttsSpeedSlider" min="0.5" max="2.0" value="1.0" majorTickUnit="0.5"
                        minorTickCount="1" showTickLabels="true" showTickMarks="true" snapToTicks="true"/>
                </VBox>
            </VBox>
            <Label text="%wizard.tts.note" styleClass="note-label" wrapText="true"/>
        </VBox>

        <!-- Step 6: summary -->
        <VBox fx:id="stepFinish" styleClass="step-pane" spacing="12">
            <Label text="%wizard.finish.body" styleClass="step-body" wrapText="true"/>
            <VBox styleClass="card" spacing="8">
                <HBox spacing="8"><Label text="%wizard.finish.language" styleClass="summary-key"/><Label
                        fx:id="summaryLanguage" styleClass="summary-value"/></HBox>
                <HBox spacing="8"><Label text="%wizard.finish.currency" styleClass="summary-key"/><Label
                        fx:id="summaryCurrency" styleClass="summary-value"/></HBox>
                <HBox spacing="8"><Label text="%wizard.finish.engine" styleClass="summary-key"/><Label
                        fx:id="summaryEngine" styleClass="summary-value"/></HBox>
                <HBox spacing="8"><Label text="%wizard.finish.tts" styleClass="summary-key"/><Label
                        fx:id="summaryTts" styleClass="summary-value"/></HBox>
                <HBox spacing="8"><Label text="%wizard.finish.token" styleClass="summary-key"/><Label
                        fx:id="summaryToken" styleClass="summary-value"/></HBox>
                <HBox spacing="8"><Label text="%wizard.finish.dataFolder" styleClass="summary-key"/><Label
                        fx:id="summaryDataFolder" styleClass="summary-value" wrapText="true"/></HBox>
            </VBox>
            <Label fx:id="finishHintLabel" styleClass="note-label" wrapText="true"/>
        </VBox>
    </StackPane>

    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="wizard-footer">
        <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" HBox.hgrow="ALWAYS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="backButton" text="%wizard.back" onAction="#goBack" styleClass="secondary-button"/>
        <Button fx:id="nextButton" text="%wizard.next" onAction="#goNext" styleClass="primary-button"/>
    </HBox>
</VBox>
