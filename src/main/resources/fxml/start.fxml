<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox id="rootbox"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.jarvisdealer.ui.StartController"
    alignment="CENTER"
    spacing="20"
    stylesheets="@../css/start.css">
    <Label id="welcomeLabel" text="Welcome to the Application!"/>
    <Button id="startButton" text="Start" onAction="#handleStartButton"/>
</VBox>