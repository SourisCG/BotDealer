<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>

<VBox id="rootbox"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.jarvisdealer.ui.StartController"
    alignment="CENTER"
    spacing="20"
    stylesheets="@../css/start.fx.css">
    <Label fx:id="welcomeLabel" text="Welcome to the Application!" styleClass="welcome-label"/>
    <Button fx:id="startButton" text="Start" onAction="#start"/>
    <ProgressBar fx:id="progressBar" visible="false"/>
</VBox>