<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>

<!-- Boot screen (Phase 0). Controller is injected by Spring via FxViewLoader. -->
<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.botdealer.ui.StartController"
    alignment="CENTER"
    spacing="18"
    styleClass="app-root"
    stylesheets="@../css/base.css, @../css/components.css, @../css/effects.css">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label fx:id="welcomeLabel" text="%app.welcome" styleClass="welcome-label"/>
    <Label fx:id="infoLabel" styleClass="info-label" wrapText="true"/>
    <Label text="%app.boot.phase0" styleClass="phase-label"/>
    <Button fx:id="startButton" text="%app.start" onAction="#start" styleClass="primary-button"/>
    <ProgressBar fx:id="progressBar" visible="false" styleClass="progress-bar"/>
</VBox>
