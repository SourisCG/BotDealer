<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.botdealer.ui.sections.MusicController"
    styleClass="section-root" spacing="12">
    <padding>
        <Insets top="26" right="30" bottom="26" left="30"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%dashboard.guild" styleClass="field-label"/>
        <ComboBox fx:id="guildCombo" prefWidth="180"/>
        <ComboBox fx:id="channelCombo" prefWidth="170" promptText="%music.channel"/>
        <Button fx:id="connectButton" onAction="#connect" styleClass="small-button"/>
        <Button fx:id="disconnectButton" onAction="#disconnect" styleClass="small-button"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <VBox styleClass="card" spacing="8">
                <Label fx:id="nowPlayingTitle" styleClass="card-title" wrapText="true"/>
                <HBox spacing="12">
                    <ImageView fx:id="artwork" fitWidth="96" fitHeight="96" preserveRatio="true"/>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="nowPlayingValue" styleClass="card-value" wrapText="true"/>
                        <ProgressBar fx:id="trackProgress" maxWidth="Infinity"/>
                        <Label fx:id="trackTime" styleClass="note-label"/>
                    </VBox>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="pauseButton" onAction="#togglePause" styleClass="small-button"/>
                    <Button fx:id="skipButton" onAction="#skip" styleClass="small-button"/>
                    <Button fx:id="stopButton" onAction="#stop" styleClass="small-button"/>
                    <Button fx:id="shuffleButton" onAction="#shuffle" styleClass="small-button"/>
                    <Button fx:id="loopButton" onAction="#loop" styleClass="small-button"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="volumeLabel" styleClass="field-label"/>
                    <Slider fx:id="volumeSlider" min="0" max="200" prefWidth="180"/>
                    <Label fx:id="volumeValue" styleClass="note-label"/>
                </HBox>
                <Label fx:id="playbackStatus" styleClass="result-label" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="8">
                <Label fx:id="addLabel" styleClass="card-title"/>
                <HBox spacing="8">
                    <TextField fx:id="queryField" promptText="%music.queryPrompt" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="playButton" onAction="#play" styleClass="primary-button"/>
                </HBox>
            </VBox>

            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="queueTitle" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="removeButton" onAction="#removeSelected" styleClass="small-button"/>
                    <Button fx:id="clearButton" onAction="#clearQueue" styleClass="small-button"/>
                </HBox>
                <TableView fx:id="queueTable" prefHeight="160" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="queueIndexColumn" text="%music.column.index" prefWidth="45"/>
                        <TableColumn fx:id="queueTitleColumn" text="%music.column.title" prefWidth="300"/>
                        <TableColumn fx:id="queueDurationColumn" text="%music.column.duration" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>

        <VBox spacing="12" prefWidth="330" minWidth="300">
            <VBox styleClass="card" spacing="8">
                <Label fx:id="engineTitle" styleClass="card-title"/>
                <Label fx:id="engineStatus" styleClass="card-value" wrapText="true"/>
                <Label fx:id="engineVersions" styleClass="note-label" wrapText="true"/>
                <HBox spacing="8">
                    <Button fx:id="updateEngineButton" onAction="#updateEngine" styleClass="small-button"/>
                    <Button fx:id="openEnginesButton" onAction="#openEnginesFolder" styleClass="small-button"/>
                </HBox>
                <Label fx:id="engineResult" styleClass="result-label" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="8">
                <Label fx:id="accountTitle" styleClass="card-title"/>
                <Label fx:id="accountStatus" styleClass="card-value" wrapText="true"/>
                <HBox spacing="8">
                    <Button fx:id="linkAccountButton" onAction="#linkAccount" styleClass="small-button"/>
                    <Button fx:id="unlinkAccountButton" onAction="#unlinkAccount" styleClass="small-button"/>
                </HBox>
                <Label fx:id="accountHint" styleClass="note-label" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="8">
                <Label fx:id="localFilesTitle" styleClass="card-title"/>
                <Label fx:id="localFilesHint" styleClass="note-label" wrapText="true"/>
                <Button fx:id="openMusicFolderButton" onAction="#openMusicFolder" styleClass="small-button"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
