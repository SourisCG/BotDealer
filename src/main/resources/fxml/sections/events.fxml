<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.botdealer.ui.sections.EventsController"
    styleClass="section-root" spacing="12">
    <padding>
        <Insets top="26" right="30" bottom="26" left="30"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%dashboard.guild" styleClass="field-label"/>
        <ComboBox fx:id="guildCombo" prefWidth="200"/>
        <Button fx:id="refreshButton" onAction="#refresh" styleClass="small-button"/>
        <Button fx:id="newEventButton" onAction="#newEvent" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="%events.column.id" prefWidth="55"/>
                    <TableColumn fx:id="titleColumn" text="%events.column.title" prefWidth="240"/>
                    <TableColumn fx:id="modeColumn" text="%events.column.mode" prefWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="%events.column.status" prefWidth="100"/>
                    <TableColumn fx:id="poolColumn" text="%events.column.pool" prefWidth="100"/>
                    <TableColumn fx:id="betsColumn" text="%events.column.bets" prefWidth="70"/>
                    <TableColumn fx:id="closesColumn" text="%events.column.closes" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="380" minWidth="320">
            <Label fx:id="detailTitle" styleClass="card-title" wrapText="true"/>
            <Label fx:id="detailSubtitle" styleClass="note-label" wrapText="true"/>
            <Label text="%events.detail.options" styleClass="field-label"/>
            <TableView fx:id="optionTable" prefHeight="200">
                <columns>
                    <TableColumn fx:id="optionIdColumn" text="%events.column.id" prefWidth="45"/>
                    <TableColumn fx:id="optionLabelColumn" text="%events.column.option" prefWidth="150"/>
                    <TableColumn fx:id="optionPoolColumn" text="%events.column.pool" prefWidth="90"/>
                    <TableColumn fx:id="optionOddsColumn" text="%events.column.odds" prefWidth="80"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button fx:id="openButton" onAction="#openEvent" styleClass="small-button"/>
                <Button fx:id="closeButton" onAction="#closeEvent" styleClass="small-button"/>
                <Button fx:id="settleButton" onAction="#settleEvent" styleClass="primary-button"/>
                <Button fx:id="cancelButton" onAction="#cancelEvent" styleClass="danger-button"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="result-label" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
