<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml"
    fx:controller="souris.botdealer.ui.dialogs.YoutubeOauthController"
    styleClass="dialog-root" spacing="12">
    <padding>
        <Insets top="18" right="20" bottom="14" left="20"/>
    </padding>

    <Label fx:id="headingLabel" styleClass="wizard-title"/>
    <Label fx:id="introLabel" styleClass="step-body" wrapText="true"/>

    <VBox styleClass="card" spacing="8">
        <Label fx:id="urlLabel" styleClass="field-label"/>
        <Label fx:id="urlValue" styleClass="card-value" wrapText="true"/>
        <Label fx:id="codeLabel" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="codeValue" styleClass="oauth-code"/>
            <Button fx:id="copyButton" onAction="#copyCode" styleClass="small-button"/>
        </HBox>
        <ProgressBar fx:id="pollProgress" prefWidth="240"/>
        <Label fx:id="statusLabel" styleClass="result-label" wrapText="true"/>
    </VBox>

    <Label fx:id="warningLabel" styleClass="note-label" wrapText="true"/>
</VBox>
